{
  "name": "fantastic-chronicle",
  "private": true,
  "version": "0.1.0",
  "description": "A cooperative tabletop card game in the spirit of 16-bit SaGa. Prototype by evilgouki.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "sim": "vite-node tools/sim.ts",
    "art": "tools/.venv/Scripts/python -I tools/art/hf_gen.py",
    "diag": "vite-node tools/diag.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
